type Loan {
  id: ID!
  contactId: Int!
  loanReference: String!
  loanType: String!
  interestType: String!
  principalAmount: Float!
  outstandingPrincipal: Float!
  interestRate: Float!
  interestFrequency: String!
  loanDate: String!
  dueDay: Int
  loanTenure: Int!
  tenureUnit: String!
  hasSecurity: Boolean!
  status: String!
  notes: String
  createdAt: String!
  updatedAt: String!
}

type Query {
  loans: [Loan!]!
  loan(id: ID!): Loan
  paymentsByLoan(loanId: Int!): [Payment!]!
  loanSummary(id: ID!): LoanSummary!
}
input NewLoan {
  contactId: Int!
  loanReference: String!
  loanType: String!
  interestType: String!
  principalAmount: Float!
  interestRate: Float!
  interestFrequency: String!
  loanDate: String!
  dueDay: Int
  loanTenure: Int!
  tenureUnit: String!
  hasSecurity: Boolean
  notes: String
}

type Mutation {
  createLoan(input: NewLoan!): Loan!
  createPayment(input: NewPayment!): Payment!
}
type Payment {
  id: ID!
  loanId: Int!
  paymentDate: String!
  paymentAmount: Float!
  paymentType: String!
  paymentMethod: String
  transactionReference: String
  notes: String
}
input NewPayment {
  loanId: Int!
  paymentDate: String!
  paymentAmount: Float!
  paymentType: String!
  paymentMethod: String
  transactionReference: String
  notes: String
}
type LoanSummary {
  loan: Loan!
  principalPaid: Float!
  interestPaid: Float!
  outstanding: Float!
  status: String!
}
extend type Mutation {
  updatePayment(id: ID!, input: NewPayment!): Payment!
  deletePayment(id: ID!): Boolean!
}
type DashboardSummary {
  totalLent: Float!
  totalBorrowed: Float!
  outstandingToReceive: Float!
  outstandingToPay: Float!
  interestEarned: Float!
  interestPaid: Float!
  netInterest: Float!
  netAssets: Float!
  netWorth: Float!
  activeLoans: Int!
  closedLoans: Int!
}
extend type Query {
  dashboardSummary: DashboardSummary!
}

type LedgerEntry {
  paymentDate: String!
  paymentAmount: Float!
  principalPaid: Float!
  interestPaid: Float!
  outstanding: Float!
  description: String!
}

extend type Query {
  loanLedger(id: ID!): [LedgerEntry!]!
  contactSummary(contactId: Int!): ContactSummary!
}
type ContactSummary {
  contactId: Int!
  totalLent: Float!
  totalBorrowed: Float!
  outstanding: Float!
  activeLoans: Int!
  closedLoans: Int!
  interestEarned: Float!
  interestPaid: Float!

  loans: [LoanSummary!]!
}
type MonthlyCashFlow {
  year: Int!
  month: Int!
  totalReceived: Float!
  totalPaid: Float!
  principalReceived: Float!
  interestReceived: Float!
  principalPaid: Float!
  interestPaid: Float!
  netCashFlow: Float!
}

extend type Query {
  monthlyCashFlow(year: Int!, month: Int!): MonthlyCashFlow!
}

input NewContact {
  contactCode: String!
  fullName: String!
  phoneNumber: String
  email: String
  address: String
  occupation: String
  contactType: String
  notes: String
}
type Contact {
  id: ID!
  contactCode: String!
  fullName: String!
  phoneNumber: String
  email: String
  address: String
  occupation: String
  contactType: String!
  notes: String
  status: String!
  createdAt: String!
  updatedAt: String!
}
extend type Mutation {
  createContact(input: NewContact!): Contact!
}